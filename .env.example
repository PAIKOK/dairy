# MongoDB is primary. Set the real URI only in ignored local env or Vercel server settings.
STORAGE_BACKEND=mongodb
MONGODB_URI=
MONGODB_DB=a_little_life_diary
# Use the exact HTTPS website origin in Vercel. Local dev can use both loopback addresses.
CLIENT_ORIGIN=http://127.0.0.1:5177,http://localhost:5177
# Required for hosted distributed rate limiting. Generate with: openssl rand -hex 32
RATE_LIMIT_SECRET=
PORT=4017
HOST=127.0.0.1
# Only used with explicit STORAGE_BACKEND=sqlite in local development; refused on Vercel.
DATA_DIR=./server/data
# Optional Google public Web client ID. Never add a client secret to frontend code.
GOOGLE_CLIENT_ID=
# Optional AI is separate from persistence and disabled unless both are configured.
GEMINI_API_KEY=
GEMINI_MODEL=
