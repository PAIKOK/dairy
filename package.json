{
  "name": "a-little-life",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "tsc --noEmit && npm run check:server && vite build",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "tsx --test server/tests/*.test.ts",
    "test:browser": "node scripts/browser-test.mjs",
    "test:browser:mongo": "node --import tsx scripts/mongo-browser-test.mjs",
    "check:server": "tsc --noEmit -p server/tsconfig.node.json",
    "test:vercel-runtime": "node scripts/vercel-runtime-test.mjs"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "google-auth-library": "^11.3.1",
    "mongodb": "7.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.14.0",
    "mongodb-memory-server": "11.3.0",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": true
    }
  }
}
