{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": false,
    "noEmit": true
  },
  "include": [
    "../api/**/*.ts",
    "./*.ts",
    "../shared/**/*.ts"
  ],
  "exclude": [
    "./tests"
  ]
}
